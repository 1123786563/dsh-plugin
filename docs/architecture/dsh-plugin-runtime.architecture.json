  "cards": [
    {
      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "Only public port: gateway :3080, HttpOnly dsh_sid session",
        "Gateway forwards HTTP/WS to loopback :38080",
        "x-dsh-identity: Ed25519 JWT, 60 s TTL, minted per request",
        "Guard verifies it via gateway JWKS — fail-closed",
        "Model calls metered + balance-gated in the host"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "dsh webserver binds 127.0.0.1 — never exposed",
        "Zero-trust private port: static assets and WS need a token",
        "Gateway down = private port unusable (fail-closed)",
        "15 privileged /api methods require the dsh-admin role",
        "Compose ports loopback-only: :8001 / :8888 / :13000"
      ]
    },
    {
      "dot": "amber",
      "title": "Billing — dsh-openmeter",
      "items": [
        "Meters every LLM call; subagents via rootSessionId",
        "WAL at-least-once delivery + 32-day dedup window",
        "Prepaid wallet: hard block when empty; outage fails open",
        "tenant→subject mapping explicit — no house fallback",
        "CNY quotes from llm-cost; cashier panel is the only admin UI"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tenant isolation — dsh-multi-tenant",
      "items": [
        "session_owners: claim-once {tenantId, userId} per session",
        "Visibility + mux frame filtering scope every event stream",
        "dsh-admin exempt; unowned sessions denied (fail-closed)",
        "401 unauthenticated · 403 unmapped/forbidden — no leaks"
      ]
    },
    {
      "dot": "violet",
      "title": "Plugin roster (cordis bundle patches)",
      "items": [
        "dsh-plane — Plane REST tools",
        "dsh-job-search — tenant-isolated job pipeline",
        "dsh-open-design — 75 skills · 152 design systems",
        "dsh-higress — OpenAI-compatible provider route",
        "dsh-nocobase — deploy wiring + health card"
      ]
    },
    {
      "dot": "slate",
      "title": "Deployment facts",
      "items": [
        "One compose file: casdoor + OpenMeter fork + NocoBase 2.2.2",
        "Kafka · ClickHouse · Redis internal; one shared Postgres",
        "NocoBase OIDC login (JIT + email bind) — separate chain",
        "OpenMeter images build from the ../openmeter fork (v3 API)"
      ]
    }
  ]
