# dsh-casdoor-gateway runtime configuration (copy to .env or export).
# Every value is operator-supplied; nothing here is reachable from requests.

# Public listener (what users visit). 0.0.0.0 only behind TLS in production.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3080
# The origin the browser uses; must match the casdoor application's redirect URI.
GATEWAY_PUBLIC_URL=http://127.0.0.1:3080

# The loopback-only dsh webserver (set by the dsh-casdoor-auth bundle patch:
#   DSH_CASDOOR_DSH_PORT, default 38080).
DSH_UPSTREAM_URL=http://127.0.0.1:38080

# Casdoor OIDC (see docker/README.md for the application bootstrap).
# 8001 because the compose file maps casdoor there (host 8000 is often taken).
CASDOOR_ISSUER=http://127.0.0.1:8001
# Internal discovery base for gateway-originated requests (discovery, token
# exchange, JWKS): empty = same origin as CASDOOR_ISSUER; in the compose
# container form it is http://casdoor:8000 so browser-facing redirects keep
# the external issuer while IdP traffic stays on the compose network.
CASDOOR_INTERNAL_ISSUER=
CASDOOR_CLIENT_ID=dsh-gateway
CASDOOR_CLIENT_SECRET=change-me-64-hex
# Claim names carrying tenant (casdoor organization) and roles.
CASDOOR_ORGANIZATION_CLAIM=organization
CASDOOR_ROLES_CLAIM=roles

# Login sessions (HttpOnly cookie -> SQLite rows).
GATEWAY_COOKIE_NAME=dsh_sid
GATEWAY_COOKIE_SECURE=false
GATEWAY_SESSION_TTL_MS=86400000
GATEWAY_DATA_DIR=

# DshIdentityToken (Ed25519 keypair lives under GATEWAY_DATA_DIR).
GATEWAY_IDENTITY_ISSUER=dsh-casdoor-gateway
GATEWAY_IDENTITY_AUDIENCE=dsh-casdoor-auth
GATEWAY_IDENTITY_HEADER=x-dsh-identity
GATEWAY_IDENTITY_TTL_SEC=60

# Privileged /api RPC methods gated to admins (comma list; default mirrors
# the host's PRIVILEGED_METHODS pin) and the casdoor role names that count.
GATEWAY_ADMIN_ROLES=dsh-admin
GATEWAY_PRIVILEGED_METHODS=

# Also end the casdoor session on logout.
GATEWAY_IDP_LOGOUT=true

LOG_LEVEL=info
