<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- com.dsh.gate-stack — 登录期保障容器门禁栈（casdoor + postgres +
     casdoor-gateway）在位的一次性 LaunchAgent：拉起 OrbStack → 循环等
     docker info 可用（最多 120s，每 5s 一次）→ compose up 幂等兜底（与
     restart: unless-stopped 双保险）。OrbStack 自启不可依赖时的兜底。
     一次性语义：RunAtLoad 且不加 KeepAlive（跑完即退出，不驻留）。
     日志：StandardOut/ErrorPath → ~/.dsh-doctor/logs/gate-stack.launchd.log
     （目录需先建，见 README 安装块）。
     本机单机部署形态：脚本内路径均为本机绝对路径，跨机器部署需按宿主调整。
     安装/卸载命令见 services/casdoor-gateway/README.md「常驻与自愈（launchd）」。 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dsh.gate-stack</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
open -ga OrbStack
for i in $(seq 1 24); do
  if docker info &gt;/dev/null 2&gt;&amp;1; then
    break
  fi
  sleep 5
done
cd /Users/wuyongjun/trea/dsh-plugin &amp;&amp; docker compose up -d casdoor postgres casdoor-gateway</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/wuyongjun/.dsh-doctor/logs/gate-stack.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/wuyongjun/.dsh-doctor/logs/gate-stack.launchd.log</string>
</dict>
</plist>
