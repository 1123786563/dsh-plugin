{
  "name": "dsh-casdoor-auth",
  "version": "0.1.0",
  "description": "Casdoor login gate for DeepSeek Harness (companion to the standalone dsh-casdoor-gateway service): verifies the gateway's DshIdentityToken into ctx.casdoorAuth, injects the 401 login-redirect watcher into the SPA shell, and assembles the dsh-multi-tenant MCP SaaS bridge on top of the authenticated TenantPrincipal.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "casdoor",
    "oidc",
    "authentication",
    "saas",
    "multi-tenant"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-multi-tenant": ">=0.3.0-rc.3 <0.4.0"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "dsh-multi-tenant": "link:../dsh-multi-tenant/packages/multi-tenant",
    "js-yaml": "4.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
