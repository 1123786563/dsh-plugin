+/** End-to-end proof that the guard principal reaches Remote domain methods on both carriers. */
+
+import { once } from 'node:events'
+import { Context, Service } from '@deepseek-ai/cordis'
+import {
+  apply as applyConnection,
+  inject as connectionInject,
+  type HostConnectionHandle,
+} from '@deepseek-ai/dsh-client-connection'
+import WebServer, { currentRequestPrincipal } from '@deepseek-ai/dsh-host-webserver'
+import { bindTypertRemote, Remote } from '@deepseek-ai/dsh-typert-protocol'
+import TypertRegistry from '@deepseek-ai/dsh-typert-registry'
+import TypertGatewayService from '@deepseek-ai/dsh-api-gateway'
+import WebSocket, { type RawData } from 'ws'
+import { describe, expect, it } from 'vitest'
+import { provideBrowserCredentials } from './browser-credentials.ts'
+
+class PrincipalEchoService extends Service {
+  readonly typertRemote = bindTypertRemote(this, 'principalEcho')
+
+  constructor(ctx: Context) {
+    super(ctx, 'principalEcho')
+  }
+
+  @Remote
+  read(): unknown {
+    return { principal: currentRequestPrincipal() }
+  }
+
+  @Remote({ mode: 'stream' })
+  async *frames(): AsyncIterable<unknown> {
+    yield { principal: currentRequestPrincipal() }
+  }
+}
+
+/** Composition under proof: the real WebServer, Connection bridge, and Gateway dispatch. */
+async function boot(): Promise<{
+  readonly ctx: Context
+  readonly port: number
+  readonly cookie: string
+  readonly dispose: () => Promise<void>
+}> {
+  const ctx = new Context()
+  provideBrowserCredentials(ctx)
+  const serverFiber = ctx.plugin(WebServer, { host: '127.0.0.1', port: 0 })
+  await serverFiber
+  const connectionFiber = ctx.plugin({ inject: [...connectionInject], apply: applyConnection })
+  await connectionFiber
+  await ctx.plugin(TypertRegistry)
+  const gatewayFiber = ctx.plugin(TypertGatewayService)
+  await gatewayFiber
+  const echoFiber = ctx.plugin(PrincipalEchoService)
+  await echoFiber
+  const origin = `http://127.0.0.1:${String(ctx.webServer.port)}`
+  return {
+    ctx,
+    port: ctx.webServer.port,
+    cookie: browserCookie(ctx.connection, origin),
+    dispose: async () => {
+      await echoFiber.dispose()
+      await gatewayFiber.dispose()
+      await connectionFiber.dispose()
+      await serverFiber.dispose()
+    },
+  }
+}
+
+/** Exchange a Connection launch token without mounting the frontend fallback. */
+function browserCookie(connection: HostConnectionHandle, origin: string): string {
+  const target = new URL(connection.authenticatedUrl(origin))
+  let setCookie: string | undefined
+  connection.authorizeIndex({
+    method: 'GET',
+    url: `${target.pathname}${target.search}`,
+    headers: { host: target.host },
+  }, {
+    writeHead(_status, headers) { setCookie = headers?.['set-cookie'] },
+    end() {},
+  })
+  if (setCookie === undefined) throw new Error('principal fixture did not receive an authentication cookie')
+  return setCookie.split(';', 1)[0]!
+}
+
+/** POST one unary principalEcho/read call and return the decoded response body. */
+async function postRead(port: number, cookie: string, rpcId: string): Promise<unknown> {
+  const response = await fetch(`http://127.0.0.1:${String(port)}/api/principalEcho/read`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json', cookie },
+    body: JSON.stringify({
+      type: 'client-request', rpcId, method: 'principalEcho/read', payload: { args: {} },
+    }),
+  })
+  expect(response.status).toBe(200)
+  return response.json()
+}
+
+/** Open the mux, request one principalEcho/frames item, and return the first frame. */
+async function firstItemFrame(port: number, cookie: string): Promise<unknown> {
+  const socket = new WebSocket(`ws://127.0.0.1:${String(port)}/api/remote.mux`, { headers: { cookie } })
+  await once(socket, 'open')
+  socket.send(JSON.stringify({
+    type: 'open', streamId: 's1', endpoint: 'principalEcho/frames', payload: { args: {} },
+  }))
+  const [frame] = await once(socket, 'message')
+  const parsed = JSON.parse(rawText(frame as RawData))
+  socket.close()
+  await once(socket, 'close')
+  return parsed
+}
+
+function rawText(data: RawData): string {
+  if (Array.isArray(data)) return Buffer.concat(data).toString('utf8')
+  if (data instanceof ArrayBuffer) return Buffer.from(data).toString('utf8')
+  return Buffer.from(data).toString('utf8')
+}
+
+describe('request principal propagation', () => {
+  it('reaches a unary Remote method through the real /api HTTP chain', { timeout: 20_000 }, async () => {
+    const { ctx, port, cookie, dispose } = await boot()
+    const release = ctx.webServer.registerGuard(() => ({ allow: true, principal: { userId: 'e2e-http' } }))
+    try {
