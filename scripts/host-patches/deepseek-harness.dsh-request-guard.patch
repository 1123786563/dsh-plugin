+/** Register one live ordinary Agent over a real Session with spied turn entry points. */
+function liveAgent(ctx: Context, id: string): { readonly agent: Agent; readonly followup: ReturnType<typeof vi.fn> } {
+  const session = ctx.sessions.create(SessionId(id), { meta: { cwd } })
+  const followup = vi.fn()
+  const agent = {
+    id: session.id, session, status: 'idle', ctx, followup, cancel: vi.fn(),
+  } as unknown as Agent
+  ctx.agents.register(agent)
+  return { agent, followup }
