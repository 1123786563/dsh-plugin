+      })
+    } finally {
+      release()
+      await dispose()
+    }
+  })
+
+  it('reports undefined without a guard principal on both carriers', { timeout: 20_000 }, async () => {
+    const { port, cookie, dispose } = await boot()
+    try {
+      // No guard is registered: the reader reports undefined, and JSON
+      // transport drops the undefined principal member from the value.
+      await expect(postRead(port, cookie, 'rpc-absent')).resolves.toEqual({
+        type: 'server-response', rpcId: 'rpc-absent',
+        result: { ok: true, value: {} },
+      })
+      await expect(firstItemFrame(port, cookie)).resolves.toEqual({
+        type: 'item', streamId: 's1', value: {},
