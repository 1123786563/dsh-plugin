+/**
+ * Control frame filter seat: seat lifecycle, baseline Session-list
+ * filtering, per-stream judgment of live queue, jobs, and projection
+ * broadcasts, jobs frames for Sessions created after open, principal
+ * passthrough, fail-closed filter throws, and the api-session
+ * reference-extraction table.
+ */
+
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { Inbox } from '@deepseek-ai/dsh-agent'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { JobOutcome } from '@deepseek-ai/dsh-jobs'
+import LocalJobRegistry from '@deepseek-ai/dsh-jobs-local'
+import { runWithRequestPrincipal } from '@deepseek-ai/dsh-host-webserver'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import type { Session } from '@deepseek-ai/dsh-session'
+import { describe, expect, it, vi } from 'vitest'
+import type { SessionController } from '../src/index.ts'
+import { SESSION_CONTROLLER_SESSION_REFERENCES } from '../src/remote-events.ts'
+import type { SessionControlFrame } from '../src/types.ts'
+import {
+  createSessionTestController,
+  createSessionTestRemote,
+  type TestSessionRemote,
+} from './test-remote.ts'
+
+const VISIBLE = SessionId('visible-session')
+const INVISIBLE = SessionId('invisible-session')
+type BaselineFrame = Extract<SessionControlFrame, { type: 'baseline' }>
+
+function message(text: string) {
+  return createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } })
+}
+
+function producer(label: string) {
+  const spec = {
+    kind: 'bash' as const,
+    label,
+    run: () => ({
+      cancel: () => {},
+      done: new Promise<JobOutcome>(() => {}),
+      readOutput: () => 'stolen output',
+    }),
+  }
+  return spec
+}
+
+interface LiveSession {
+  readonly session: Session
+  readonly agent: Agent
+  readonly inbox: Inbox
+}
+
+interface Bench {
+  readonly ctx: Context
+  readonly controller: SessionController
+  readonly remote: TestSessionRemote
+  readonly visible: LiveSession
+  readonly invisible: LiveSession
+}
+
+async function boot(): Promise<Bench> {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
