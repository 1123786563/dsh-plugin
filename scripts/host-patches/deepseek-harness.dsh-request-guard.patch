+/**
+ * One control stream generation drained continuously into a frame log; the
+ * single drain loop keeps every pushed frame ordered without competing pulls.
+ */
+class ControlRecorder {
+  private readonly collected: SessionControlFrame[] = []
+  private failure: unknown
+  private ended = false
+  private wake: (() => void) | undefined
+  private readonly abort = new AbortController()
+
+  constructor(remote: TestSessionRemote) {
+    void (async () => {
+      try {
+        for await (const frame of remote.control(this.abort.signal)) {
+          this.collected.push(frame)
+          this.flush()
+        }
+      } catch (error) {
+        this.failure = error
+        this.flush()
+      } finally {
+        this.ended = true
+        this.flush()
+      }
+    })()
+  }
+
+  private flush(): void {
+    const wake = this.wake
+    this.wake = undefined
+    wake?.()
+  }
+
+  /** Frames collected so far, the generation baseline first. */
+  get frames(): readonly SessionControlFrame[] {
+    return this.collected
+  }
+
+  /**
+   * Wait for one position in the frame log.
+   * @param index - frame position; 0 is the generation baseline.
+   * @returns the collected frame at that position.
+   */
+  async frame(index: number): Promise<SessionControlFrame> {
+    while (this.collected.length <= index) {
+      if (this.failure !== undefined) throw this.failure
+      if (this.ended) throw new Error('control stream ended before the expected frame')
+      await new Promise<void>((resolve) => { this.wake = resolve })
+    }
+    return this.collected[index] as SessionControlFrame
+  }
+
+  /** Assert no further frame is collected across two macrotask boundaries. */
+  async expectQuiet(): Promise<void> {
+    await new Promise(resolve => setTimeout(resolve, 0))
+    const before = this.collected.length
+    await new Promise(resolve => setTimeout(resolve, 0))
+    expect(this.collected.length).toBe(before)
+  }
+
+  /** End the generation and settle the drain loop. */
+  async close(): Promise<void> {
+    this.abort.abort()
+    while (!this.ended) await new Promise<void>((resolve) => { this.wake = resolve })
+  }
+}
