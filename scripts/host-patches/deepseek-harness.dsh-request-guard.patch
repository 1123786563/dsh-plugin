index 0000000000..ebca2d019e
--- /dev/null
+++ b/packages/api/session-controller/tests/access.host.spec.ts
@@ -0,0 +1,525 @@
+/**
+ * Session access filter hooks: seat lifecycle, list and search outlet
+ * filtering, admission on every wired Remote method, creation notification,
+ * fail-closed behavior without a request principal, and the reusable
+ * `assertSessionAccess` admission primitive.
+ */
+
+import { mkdtempSync, realpathSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent, AgentFactory } from '@deepseek-ai/dsh-agent'
+import { AttachmentId } from '@deepseek-ai/dsh-attachment'
+import { runWithRequestPrincipal } from '@deepseek-ai/dsh-host-webserver'
+import { createUserMessage, MessageId } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import type { Session, SessionHeader } from '@deepseek-ai/dsh-session'
+import {
+  SessionQueryEngine,
+  type SessionSearchHit,
+} from '@deepseek-ai/dsh-session-query'
+import { snapshotSubagentDescriptor } from '@deepseek-ai/dsh-subagent'
+import { subagentIdentityProjectionDefinition } from '@deepseek-ai/dsh-subagent/src/projection.ts'
+import { describe, expect, it, vi } from 'vitest'
+import { SessionAccessPolicy } from '../src/access.ts'
+import type { SessionController } from '../src/index.ts'
+import type { SessionRequestId } from '../src/types.ts'
+import {
+  createSessionTestController,
+  createSessionTestRemote,
+  installSessionReadTestServices,
+  type TestSessionRemote,
+} from './test-remote.ts'
+
+const principal = { userId: 'u1' }
+const withPrincipal = <T>(run: () => Promise<T>): Promise<T> =>
+  runWithRequestPrincipal(principal, run)
+
+const cwd = realpathSync(mkdtempSync(join(tmpdir(), 'dsh-session-access-')))
+const defaults = { defaultModelSelection: () => ({ provider: 'fixture', model: 'fixture-model' }), cwd }
+
+const promptRequest = (sessionId: SessionId) => ({
+  requestId: 'access-prompt' as SessionRequestId,
+  sessionId,
+  mode: 'queue' as const,
+  content: [{ type: 'text' as const, text: 'hello' }],
+})
+
+/** Register one live ordinary Agent over a real Session with spied turn entry points. */
+function liveAgent(ctx: Context, id: string): { readonly agent: Agent; readonly followup: ReturnType<typeof vi.fn> } {
+  const session = ctx.sessions.create(SessionId(id), { meta: { cwd } })
+  const followup = vi.fn()
+  const agent = {
+    id: session.id, session, status: 'idle', ctx, followup, cancel: vi.fn(),
+  } as unknown as Agent
+  ctx.agents.register(agent)
+  return { agent, followup }
+}
+
+/** Register one Session whose log holds one completed turn (commands-create-fork fixture). */
+function completedSession(ctx: Context, id: string): Session {
+  const session = ctx.sessions.create(SessionId(id), { meta: { cwd } })
+  session.append('turn/start', { turn: 1 })
+  session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text: 'work' }], source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+  session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+  return session
+}
+
+/** Real query core with a programmable full-text provider (session-search fixture). */
+class SearchSessionQuery extends SessionQueryEngine {
+  constructor(
+    ctx: Context,
+    private readonly search: (
+      ...args: Parameters<SessionQueryEngine['searchSessions']>
+    ) => Promise<unknown>,
+  ) {
+    super(ctx)
+  }
+
+  override searchSessions(
+    ...args: Parameters<SessionQueryEngine['searchSessions']>
+  ): ReturnType<SessionQueryEngine['searchSessions']> {
+    return this.search(...args) as ReturnType<SessionQueryEngine['searchSessions']>
+  }
+
+  override searchEvents(): Promise<never> {
+    return Promise.reject(new Error('event search is not configured in this test'))
+  }
+}
+
+function searchHit(id: string, index = 0): SessionSearchHit {
+  const header: SessionHeader = { version: 0, id: SessionId(id), createdAt: 100, cwd }
+  return {
+    header,
+    live: true,
+    persisted: false,
+    bestMatch: {
+      sessionId: header.id,
+      seq: index,
+      type: 'user/message',
+      time: 200 + index,
+      surface: 'current',
+      snippet: `match ${index}`,
+    },
+  }
+}
+
+interface Bench {
+  readonly ctx: Context
+  readonly controller: SessionController
+  readonly remote: TestSessionRemote
+}
+
+/** Boot one full Session Controller; `beforeController` installs test-local services first. */
+async function boot(beforeController?: (ctx: Context) => void): Promise<Bench> {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  ctx.provide('llm', {
+    listProviders: () => [{ id: 'fixture', name: 'fixture' }],
+    resolveCallConfig: async (request: { provider: string; model: string }) => request,
+  } as never)
+  ctx.provide('workspaceRegistry', { get: () => undefined, list: () => [] } as never)
+  // Store-backed structural factory: create and fork forward seed/meta into the
+  // real SessionStore and register an idle Agent stub over the result.
+  const factory: AgentFactory = {
+    async createAgent(_ownerCtx, options) {
+      const session = ctx.sessions.create(options.sessionId, {
+        ...options.seed === undefined ? {} : { seed: [...options.seed] },
+        ...options.meta === undefined ? {} : { meta: options.meta },
+      })
+      const agent = { id: session.id, session, status: 'idle' } as Agent
+      const agentCtx = ctx.extend({ agent })
+      ;(agent as { ctx?: Context }).ctx = agentCtx
+      await options.setup?.(agentCtx)
+      const unregister = ctx.agents.register(agent)
+      return { agent, dispose: () => { unregister(); return Promise.resolve() } }
+    },
+    async resume() {
+      throw new Error('access harness has no persisted sessions')
+    },
+  }
+  ctx.agents.setFactory(factory)
+  beforeController?.(ctx)
+  return {
+    ctx,
+    controller: createSessionTestController(ctx, defaults),
+    remote: createSessionTestRemote(ctx, defaults),
+  }
+}
+
+describe('session filter seat', () => {
+  it('rejects a second registration and releases the seat on dispose', async () => {
+    const { ctx, controller, remote } = await boot()
+    const dispose = controller.registerSessionFilter({})
+    expect(() => controller.registerSessionFilter({})).toThrow(/filter hooks already registered/)
+
+    dispose()
+    // The seat is free again (HMR disposal semantics) and behavior is unchanged.
+    const reRegistered = controller.registerSessionFilter({})
+    reRegistered()
+    await expect(remote.list({})).resolves.toMatchObject({ ok: true, value: { items: [] } })
+    await ctx.fiber.dispose()
+  })
+
+  it('leaves list, page, and the admission primitive unchanged while unregistered', async () => {
+    const { ctx, controller, remote } = await boot()
+    const session = completedSession(ctx, 'seat-unconfigured')
+
+    await expect(remote.list({})).resolves.toMatchObject({
+      ok: true,
+      value: { items: [{ sessionId: 'seat-unconfigured' }] },
+    })
+    await expect(remote.page({
+      address: { kind: 'session', sessionId: session.id }, throughSeq: 0,
+    }, new AbortController().signal)).resolves.toMatchObject({ ok: true })
+    await expect(controller.assertSessionAccess(session.id)).resolves.toBeUndefined()
+    await ctx.fiber.dispose()
+  })
+})
+
+describe('session filter listFilter', () => {
+  it('filters list rows for the request principal', async () => {
+    const { ctx, controller, remote } = await boot()
+    ctx.sessions.create(SessionId('list-alpha'), { meta: { cwd } })
+    ctx.sessions.create(SessionId('list-beta'), { meta: { cwd } })
+    const seen: unknown[] = []
+    controller.registerSessionFilter({
+      listFilter: (who, items) => {
+        seen.push(who)
+        return items.filter(item => item.sessionId === SessionId('list-alpha'))
+      },
+    })
+
+    const response = await withPrincipal(() => remote.list({}))
+
+    expect(seen[0]).toBe(principal)
+    expect(response).toMatchObject({ ok: true, value: { items: [{ sessionId: 'list-alpha' }] } })
+    await ctx.fiber.dispose()
+  })
+
+  it('filters search items without recomputing hasMore', async () => {
+    const { ctx, controller, remote } = await boot((bench) => {
+      const hits = Array.from({ length: 21 }, (_, index) => searchHit(`search-${String(index)}`))
+      new SearchSessionQuery(bench, vi.fn()
+        .mockResolvedValueOnce({ items: hits.slice(0, 20), nextCursor: 'page-2' })
+        .mockResolvedValueOnce({ items: hits.slice(20) }))
+    })
+    for (let index = 0; index < 21; index++) {
+      ctx.sessions.create(SessionId(`search-${String(index)}`), { meta: { cwd } })
+    }
+    controller.registerSessionFilter({
+      listFilter: (_who, items) => items.filter(item => item.sessionId === SessionId('search-0')),
+    })
+
+    const response = await withPrincipal(() => remote.search({ query: 'match' }, new AbortController().signal))
+
+    // hasMore describes the provider page before filtering: 20 collected hits
+    // reached the result boundary even though only one row survives.
+    expect(response).toMatchObject({
+      ok: true,
+      value: { items: [{ sessionId: 'search-0', snippet: 'match 0' }], hasMore: true },
+    })
+    await ctx.fiber.dispose()
+  })
+
+  it('denies list and search fail-closed without a request principal', async () => {
+    const { ctx, controller, remote } = await boot()
+    controller.registerSessionFilter({ listFilter: () => [] })
+
+    await expect(remote.list({})).resolves.toMatchObject({
+      ok: false,
+      error: { code: 'forbidden' },
+    })
+    await expect(remote.search({ query: 'match' }, new AbortController().signal)).resolves.toMatchObject({
+      ok: false,
+      error: { code: 'forbidden' },
+    })
+    await ctx.fiber.dispose()
+  })
+
+  it('denies and warns when the filter throws', async () => {
+    const { ctx, controller, remote } = await boot()
+    const warn = vi.spyOn(ctx.logger, 'warn').mockImplementation(() => {})
+    controller.registerSessionFilter({
+      listFilter: () => {
+        throw new Error('filter offline')
+      },
+    })
+
+    await expect(withPrincipal(() => remote.list({}))).resolves.toMatchObject({
+      ok: false,
+      error: { code: 'forbidden' },
+    })
+    expect(warn).toHaveBeenCalledWith(expect.stringContaining('listFilter'))
+    await ctx.fiber.dispose()
+  })
+
+  it('leaves list unfiltered when the seat holds no listFilter', async () => {
+    const { ctx, controller, remote } = await boot()
+    ctx.sessions.create(SessionId('unfiltered'), { meta: { cwd } })
+    controller.registerSessionFilter({ accessCheck: () => true })
+
+    // accessCheck alone never gates list, with or without a principal.
+    await expect(remote.list({})).resolves.toMatchObject({
+      ok: true,
+      value: { items: [{ sessionId: 'unfiltered' }] },
+    })
+    await expect(withPrincipal(() => remote.list({}))).resolves.toMatchObject({
+      ok: true,
+      value: { items: [{ sessionId: 'unfiltered' }] },
+    })
+    await ctx.fiber.dispose()
+  })
+})
+
