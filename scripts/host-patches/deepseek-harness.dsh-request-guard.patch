+/** Boot one full Session Controller; `beforeController` installs test-local services first. */
+async function boot(beforeController?: (ctx: Context) => void): Promise<Bench> {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  ctx.provide('llm', {
+    listProviders: () => [{ id: 'fixture', name: 'fixture' }],
+    resolveCallConfig: async (request: { provider: string; model: string }) => request,
+  } as never)
+  ctx.provide('workspaceRegistry', { get: () => undefined, list: () => [] } as never)
+  // Store-backed structural factory: create and fork forward seed/meta into the
+  // real SessionStore and register an idle Agent stub over the result.
+  const factory: AgentFactory = {
+    async createAgent(_ownerCtx, options) {
+      const session = ctx.sessions.create(options.sessionId, {
+        ...options.seed === undefined ? {} : { seed: [...options.seed] },
+        ...options.meta === undefined ? {} : { meta: options.meta },
+      })
+      const agent = { id: session.id, session, status: 'idle' } as Agent
+      const agentCtx = ctx.extend({ agent })
+      ;(agent as { ctx?: Context }).ctx = agentCtx
+      await options.setup?.(agentCtx)
+      const unregister = ctx.agents.register(agent)
+      return { agent, dispose: () => { unregister(); return Promise.resolve() } }
+    },
+    async resume() {
+      throw new Error('access harness has no persisted sessions')
+    },
+  }
+  ctx.agents.setFactory(factory)
+  beforeController?.(ctx)
+  return {
+    ctx,
+    controller: createSessionTestController(ctx, defaults),
+    remote: createSessionTestRemote(ctx, defaults),
+  }
